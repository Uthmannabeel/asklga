# Copy to .env.local and fill in.

# The answer engine needs one model provider. Set the key for the one you use.
# Gemini has a free tier that is enough for a pilot; Anthropic (Claude) is the other option.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use: gemini or anthropic. When unset, the provider whose key is set is
# used (Anthropic if both keys are set).
# ASKLGA_PROVIDER=gemini

# Model used by the answer engine (default gemini-3.5-flash-lite for Gemini, the only tier whose
# free daily cap lasts a working day; claude-opus-5 for Anthropic). The model in use is recorded
# with every scoreboard run.
# ASKLGA_MODEL=gemini-3.5-flash-lite

# Server passcode used only for first-run setup of the staff workspace (/admin): sign in with it
# once, create the first administrator account, and it stops working. The placeholder value is
# refused and anything shorter than 12 characters is warned about; use a long passphrase.
ADMIN_PASSCODE=change-me

# Rate limits key on the client address. On Vercel it comes from the platform. Self-hosted, put
# the app behind one reverse proxy that sets X-Forwarded-For (nginx, Caddy) and set this to the
# number of proxies; without it every caller shares one bucket. Never expose port 3000 directly.
# TRUST_PROXY_HOPS=1

# What the staff workspace does with internal documents: "search" (default) matches them by
# keyword on this server and never sends them to the model provider, which is the build plan's
# rule for foreign inference; "model" sends them like public content and needs the partner's
# written sign-off or a Nigerian-hosted model.
# ASKLGA_INTERNAL_SCOPE=search

# Alerts for new tickets, flagged answers and investor enquiries. Any combination; none = workspace only.
# ALERT_WEBHOOK_URL=https://hooks.example/...          POST JSON {kind, lgaId, title, body, link}
# RESEND_API_KEY=                                       email via resend.com
# ALERT_EMAIL_TO=planning@lga.example, works@lga.example
# ALERT_EMAIL_FROM=AskLGA <alerts@yourdomain>
# TERMII_API_KEY=                                       SMS via termii.com (Nigerian numbers)
# TERMII_SENDER_ID=AskLGA
# ALERT_SMS_TO=2348030000000

# Optional: separate secret for signing session cookies and feedback tokens. When unset the
# passcode is used. Set a random 32+ character value in production so rotating the passcode
# does not invalidate every session.
# SESSION_SECRET=

# Optional: answer-engine budgets (requests). Defaults: 6 per minute and 60 per day per
# connection, 2000 per day per LGA. Raise them once billing is enabled on the model key.
# ASK_RATE_PER_MIN=6
# ASK_RATE_PER_DAY=60
# ASK_LGA_PER_DAY=2000

# Optional: Postgres connection string. When unset, an embedded Postgres (PGlite) is used
# and stored under ./data/pglite. Production must point at a Postgres hosted in Nigeria.
# DATABASE_URL=postgres://user:pass@host:5432/asklga

# Optional: seed demo Obio/Akpor records on first start. Defaults to true only for the embedded
# local database; a deployment with DATABASE_URL never seeds unless this is set to true.
# AUTO_SEED=true

# Public base URL, used in the widget snippet shown on the Open data page.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public contact address shown on /about and /join (optional)
CONTACT_EMAIL=
